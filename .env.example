# Not required to run the current simulated prototype (sensing_sim.py
# generates synthetic data locally, no network calls). These are placeholders
# for the Phase 1 pilot described in the proposal, once real RTL-SDR sensing
# nodes and a ZCHPC Cloud Compute Environment (CCE) deployment exist.

# MQTT broker real sensing nodes would publish readings to.
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883

# ZCHPC Cloud Compute Environment endpoint for hosted model training/serving.
ZCHPC_CCE_API_ENDPOINT=
ZCHPC_CCE_API_KEY=
