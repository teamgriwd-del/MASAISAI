# Environment variables the LIVE phase1 pipeline actually reads (ingest_service.py,
# live_dashboard.py) -- distinct from the repo-root .env.example, which covers the
# not-yet-built future ZCHPC CCE deployment. These are what's really running on the VPS today.
# Never commit this file with real values -- only ever ship it with the variable names blank.

# Mosquitto MQTT broker (local to the VPS, authenticated)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USER=masaisai_node
MQTT_PASS=

# MySQL (local to the VPS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=masaisai_app
DB_PASS=
DB_NAME=masaisai
